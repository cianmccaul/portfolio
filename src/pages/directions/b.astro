---
/**
 * MOCKUP — Direction B, "Broadsheet".
 * Type leads. The name runs the width of the page, logistics are a spec sheet
 * instead of chips, and the clinic suite is a full-bleed deep-teal band where
 * a phone steps through the real booking flow.
 */
import { Picture } from 'astro:assets';
import MockLayout from '../../components/directions/MockLayout.astro';
import Icon from '../../components/Icon.astro';
import desktop from '../../assets/work/clinic-booking-desktop.png';
import step1 from '../../assets/work/clinic-step-treatment.png';
import step2 from '../../assets/work/clinic-step-practitioner.png';
import step3 from '../../assets/work/clinic-booking-phone.png';
import triageShot from '../../assets/work/email-triage.png';
import chatShot from '../../assets/work/clinic-chatbot.png';
import { basics, specs, figures, platform, triage, chatbot, suite } from '../../components/directions/shared';
import { inline } from '../../lib/site';

const steps = [
  { shot: step1, title: 'Choose a treatment', detail: 'New or returning patient, then the treatment.' },
  { shot: step2, title: 'Choose a practitioner', detail: 'A named therapist, or whoever is free first.' },
  { shot: step3, title: 'Choose a time', detail: 'Re-checked against the diary, then held while they pay.' },
];
---

<MockLayout name="Broadsheet" letter="b">
  <section class="hero">
    <div class="aurora"></div>
    <div class="m-wrap">
      <h1 class="m-hero-name">{basics.name}</h1>
      <div class="cols">
        <div>
          <p class="line">{basics.headline}</p>
          <p class="lede" set:html={inline(basics.summary)} />
          <div class="actions">
            <a class="btn btn-primary" href="/cv/">View CV</a>
            <a class="btn btn-secondary" href="#suite">Selected work<Icon name="arrow-down" /></a>
          </div>
        </div>
        <dl class="specs">
          {specs.map((s) => <div><dt>{s.term}</dt><dd>{s.value}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="m-wrap figures" aria-label="Proof">
    {
      figures.map((f) => (
        <div>
          <p class="m-figure">{f.value}<small>{f.unit}</small></p>
          <p class="cap">{f.label}</p>
        </div>
      ))
    }
  </section>

  <section id="suite" class="night band">
    <div class="aurora-night"></div>
    <div class="m-wrap">
      <p class="kicker muted">{suite.name}</p>
      <h2>{platform.name}</h2>
      <p class="tag muted">{platform.tagline} {platform.fact}</p>

      <div class="stepper" data-stepper>
        <div class="phone">
          <div class="screen">
            {
              steps.map((s, i) => (
                <div class="frame" data-frame data-on={i === 0 ? '' : undefined}>
                  <Picture src={s.shot} alt={`The demo on a phone: ${s.title.toLowerCase()}.`} formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 780]} sizes="300px" loading={i === 0 ? 'eager' : 'lazy'} />
                </div>
              ))
            }
          </div>
        </div>
        <div class="side">
          <p class="muted small">The patient’s side, on a phone</p>
          <ol>
            {
              steps.map((s, i) => (
                <li>
                  <button type="button" data-step aria-pressed={i === 0 ? 'true' : 'false'}>
                    <span class="n">{i + 1}</span>
                    <span><b>{s.title}</b><span class="d">{s.detail}</span></span>
                  </button>
                </li>
              ))
            }
          </ol>
          <p class="then glass-night">Then they pay, the appointment is created in the diary, and reception sees it.</p>
          <a class="btn btn-night" href="/work/clinic-platform/">Read the case study<Icon name="arrow-right" /></a>
        </div>
        <div class="wide browser">
          <div class="browser-bar"><i></i><i></i><i></i><span>cian-clinic-demo.vercel.app</span></div>
          <Picture src={desktop} alt="The same booking step on a desktop." formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1440]} sizes="(min-width: 1024px) 560px, 92vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="m-wrap more">
    {
      [
        { item: triage, shot: triageShot, href: `/work/${triage.slug}/`, cta: 'Read the case study' },
        { item: chatbot, shot: chatShot, href: chatbot.demo, cta: 'Try the demo' },
      ].map(({ item, shot, href, cta }, i) => (
        <article class:list={[i === 1 && 'flip']}>
          <div class="browser"><Picture src={shot} alt={item.imageAlt ?? ''} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 960]} sizes="(min-width: 1024px) 680px, 92vw" class="shot" /></div>
          <div>
            <h3>{item.name}</h3>
            <p class="tag2">{item.tagline}</p>
            <p class="fact">{item.fact}</p>
            <a class="m-link" href={href}>{cta}<Icon name="arrow-right" /></a>
          </div>
        </article>
      ))
    }
  </section>
</MockLayout>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-stepper]')) {
    const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    let timers: number[] = [];
    const go = (index: number) => {
      frames.forEach((frame, i) => frame.toggleAttribute('data-on', i === index));
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
    };
    buttons.forEach((button, i) =>
      button.addEventListener('click', () => {
        timers.forEach(clearTimeout);
        go(i);
      }),
    );
    // Plays through once when it scrolls into view, then it's yours.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          timers = [window.setTimeout(() => go(1), 1400), window.setTimeout(() => go(2), 2800)];
        },
        { threshold: 0.5 },
      ).observe(root);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: calc(var(--spacing-64) * -1 - var(--spacing-16));
    padding: var(--spacing-128) 0 var(--spacing-64);
  }
  .m-hero-name {
    font-size: clamp(3.25rem, 0.413rem + 12.61vw, 10.5rem); /* 52 → 168: the name is the layout */
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .cols {
    display: grid;
    gap: var(--spacing-48);
    margin-top: var(--spacing-48);
    padding-top: var(--spacing-32);
    border-top: 1px solid var(--color-ink);
  }
  .line {
    max-width: 14em;
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .lede {
    margin-top: var(--spacing-16);
    max-width: 34em;
    color: var(--color-muted);
    font-size: var(--text-body-lg);
    line-height: 1.55;
  }
  .lede :global(strong) {
    color: var(--color-ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-12);
    margin-top: var(--spacing-32);
  }
  .specs div {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: var(--spacing-16);
    padding-block: var(--spacing-12);
    border-bottom: 1px solid var(--color-line-strong);
  }
  .specs div:first-child {
    padding-top: 0;
  }
  .specs dt {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .specs dd {
    font-weight: 500;
  }

  .figures {
    display: grid;
    gap: var(--spacing-32) var(--spacing-48);
    padding-block: var(--spacing-48) var(--spacing-section);
  }
  .figures .m-figure {
    font-size: clamp(4rem, 1.652rem + 10.43vw, 10rem); /* 64 → 160 */
    letter-spacing: -0.055em;
  }
  .m-figure small {
    color: var(--color-muted);
  }
  .cap {
    margin-top: var(--spacing-12);
    max-width: 22em;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .band {
    padding-block: var(--spacing-section);
    overflow: hidden;
  }
  .kicker {
    font-size: var(--text-h3);
  }
  .band h2 {
    margin-top: var(--spacing-8);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .tag {
    margin-top: var(--spacing-24);
    max-width: 34em;
    font-size: var(--text-body-lg);
  }
  .stepper {
    display: grid;
    gap: var(--spacing-48);
    align-items: center;
    margin-top: var(--spacing-64);
  }
  .stepper .phone {
    width: min(300px, 78vw);
    margin-inline: auto;
  }
  .frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .frame[data-on] {
    opacity: 1;
  }
  .small {
    font-size: var(--text-small);
  }
  ol {
    margin-top: var(--spacing-8);
  }
  ol button {
    display: flex;
    gap: var(--spacing-16);
    width: 100%;
    padding: var(--spacing-16) 0;
    border-top: 1px solid var(--night-line);
    text-align: left;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity var(--dur-fast) ease;
  }
  ol button[aria-pressed='true'] {
    opacity: 1;
  }
  ol b {
    display: block;
    font-size: var(--text-h3);
    font-weight: 600;
  }
  .n {
    width: var(--spacing-24);
    padding-top: var(--spacing-4);
    color: var(--night-accent);
    font-size: var(--text-small);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .d {
    display: block;
    color: var(--night-muted);
    font-size: var(--text-small);
  }
  .then {
    margin-block: var(--spacing-16) var(--spacing-32);
    padding: var(--spacing-12) var(--spacing-16);
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
  }
  .wide {
    display: none;
  }

  .more {
    display: grid;
    gap: var(--spacing-64);
    padding-block: var(--spacing-section);
  }
  .more article {
    display: grid;
    gap: var(--spacing-24) var(--spacing-48);
    align-items: center;
  }
  .more :global(.shot) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .more h3 {
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .tag2 {
    margin-top: var(--spacing-12);
    color: var(--color-muted);
    font-size: var(--text-body-lg);
  }
  .fact {
    margin-top: var(--spacing-16);
    max-width: 30em;
  }
  @media (min-width: 768px) {
    .figures {
      grid-template-columns: repeat(3, 1fr);
    }
    .more article {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .more .flip > :first-child {
      order: 2;
    }
    .more .flip {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  @media (min-width: 1024px) {
    .cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .stepper {
      grid-template-columns: 300px minmax(0, 1fr) minmax(0, 1.3fr);
    }
    .wide {
      display: block;
      margin-right: calc(var(--spacing-128) * -1);
    }
  }
</style>
