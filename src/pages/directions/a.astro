---
/**
 * MOCKUP — Direction A, "Front desk".
 * The product sits beside the name: a living reception dashboard in the hero,
 * on a light aurora, then the clinic suite on a full-bleed dark band.
 */
import { Picture } from 'astro:assets';
import MockLayout from '../../components/directions/MockLayout.astro';
import LivingDashboard from '../../components/directions/LivingDashboard.astro';
import Icon from '../../components/Icon.astro';
import desktop from '../../assets/work/clinic-booking-desktop.png';
import phone from '../../assets/work/clinic-booking-phone.png';
import triageShot from '../../assets/work/email-triage.png';
import chatShot from '../../assets/work/clinic-chatbot.png';
import { basics, chips, figures, platform, triage, chatbot, suite } from '../../components/directions/shared';
import { inline } from '../../lib/site';
---

<MockLayout name="Front desk" letter="a">
  <section class="hero">
    <div class="aurora"></div>
    <div class="m-wrap grid">
      <div class="copy">
        <p class="label">{basics.label}</p>
        <h1 class="m-hero-name">{basics.name}</h1>
        <p class="line">{basics.headline}</p>
        <p class="lede" set:html={inline(basics.summary)} />
        <ul class="chips">{chips.map((c) => <li class="chip">{c}</li>)}</ul>
        <div class="actions">
          <a class="btn btn-primary" href="/cv/">View CV</a>
          <a class="btn btn-secondary" href="#suite">Selected work<Icon name="arrow-down" /></a>
        </div>
      </div>
      <div class="stage">
        <div class="browser">
          <div class="browser-bar"><i></i><i></i><i></i><span>Reception · Northbank Physio (demo)</span></div>
          <LivingDashboard />
        </div>
      </div>
    </div>
  </section>

  <section class="m-wrap figures" aria-label="Proof">
    {
      figures.map((f) => (
        <div>
          <p class="m-figure">{f.value}<small>{f.unit}</small></p>
          <p class="cap">{f.label}</p>
        </div>
      ))
    }
  </section>

  <section id="suite" class="night band">
    <div class="m-wrap">
      <div class="intro">
        <h2>{suite.name}</h2>
        <p class="muted">{suite.summary}</p>
      </div>

      <div class="flagship">
        <div class="shots">
          <div class="browser">
            <div class="browser-bar"><i></i><i></i><i></i><span>cian-clinic-demo.vercel.app</span></div>
            <Picture src={desktop} alt="The demo booking page: choosing a time with a physiotherapist." formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1440]} sizes="(min-width: 1024px) 720px, 92vw" />
          </div>
          <div class="phone"><div class="screen"><Picture src={phone} alt="The same booking step on a phone." formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 780]} sizes="220px" /></div></div>
          <p class="over glass-night">Live since October 2026</p>
        </div>
        <div class="about">
          <h3>{platform.name}</h3>
          <p class="tag muted">{platform.tagline}</p>
          <p>{platform.fact}</p>
          <dl>
            <div><dt class="muted">Role</dt><dd>{platform.role}</dd></div>
            <div><dt class="muted">Client</dt><dd>{platform.client}</dd></div>
            <div><dt class="muted">Stack</dt><dd>{platform.stack.slice(0, 3).join(' · ')}</dd></div>
          </dl>
          <a class="btn btn-night" href="/work/clinic-platform/">Read the case study<Icon name="arrow-right" /></a>
        </div>
      </div>

      <div class="pair">
        {
          [
            { item: triage, shot: triageShot, cta: true },
            { item: chatbot, shot: chatShot, cta: false },
          ].map(({ item, shot, cta }) => (
            <article>
              <div class="browser">
                <Picture src={shot} alt={item.imageAlt ?? ''} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 960]} sizes="(min-width: 768px) 560px, 92vw" class="shot" />
              </div>
              <h3>{item.name}</h3>
              <p class="muted">{item.tagline}</p>
              {cta ? (
                <a class="m-link" href={`/work/${item.slug}/`}>Read the case study<Icon name="arrow-right" /></a>
              ) : (
                <a class="m-link" href={item.demo}>Try the demo<Icon name="arrow-up-right" /></a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</MockLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: calc(var(--spacing-64) * -1 - var(--spacing-16));
    padding: var(--spacing-128) 0 var(--spacing-64);
  }
  .grid {
    display: grid;
    gap: var(--spacing-64) var(--spacing-48);
    align-items: center;
  }
  .label {
    color: var(--color-muted);
    font-size: var(--text-h3);
  }
  .m-hero-name {
    margin-top: var(--spacing-8);
  }
  .line {
    margin-top: var(--spacing-24);
    max-width: 16em;
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .lede {
    margin-top: var(--spacing-16);
    max-width: 34em;
    color: var(--color-muted);
    font-size: var(--text-body-lg);
    line-height: 1.55;
  }
  .lede :global(strong) {
    color: var(--color-ink);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8);
    margin-top: var(--spacing-24);
  }
  .chips .chip {
    background: oklch(1 0 0 / 0.55);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-12);
    margin-top: var(--spacing-32);
  }
  .stage {
    padding-bottom: var(--spacing-48);
  }
  .stage .browser {
    overflow: visible;
  }
  .stage .browser-bar {
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  .stage :global(.live) {
    border-radius: 0 0 var(--radius-md) var(--radius-md);
  }

  .figures {
    display: grid;
    gap: var(--spacing-32) var(--spacing-48);
    padding-block: var(--spacing-32) var(--spacing-section);
  }
  .figures > div {
    padding-top: var(--spacing-24);
    border-top: 1px solid var(--color-line-strong);
  }
  .m-figure small {
    color: var(--color-muted);
  }
  .cap {
    margin-top: var(--spacing-12);
    max-width: 24em;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .band {
    padding-block: var(--spacing-section);
  }
  .intro {
    display: grid;
    gap: var(--spacing-12) var(--spacing-24);
    align-items: baseline;
  }
  .intro h2 {
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .intro p {
    max-width: var(--container-prose);
    font-size: var(--text-body-lg);
  }
  .flagship {
    display: grid;
    gap: var(--spacing-48);
    align-items: center;
    margin-top: var(--spacing-64);
  }
  .shots {
    position: relative;
    padding: 0 var(--spacing-32) var(--spacing-48) 0;
  }
  .shots .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 30%;
    min-width: 120px;
    border-radius: 28px;
    padding: var(--spacing-4);
  }
  .shots .phone > .screen {
    border-radius: 24px;
  }
  .over {
    position: absolute;
    left: var(--spacing-16);
    bottom: var(--spacing-16);
    padding: var(--spacing-8) var(--spacing-16);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: 500;
  }
  .about h3 {
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .tag {
    margin-top: var(--spacing-8);
    font-size: var(--text-body-lg);
  }
  .about > p:not(.tag) {
    margin-top: var(--spacing-16);
  }
  dl {
    display: grid;
    gap: var(--spacing-8);
    margin-block: var(--spacing-24) var(--spacing-32);
    font-size: var(--text-small);
  }
  dl div {
    display: grid;
    grid-template-columns: 5em 1fr;
    gap: var(--spacing-16);
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--night-line);
  }
  .pair {
    display: grid;
    gap: var(--spacing-48) var(--spacing-24);
    margin-top: var(--spacing-96);
  }
  .pair :global(.shot) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .pair h3 {
    margin-top: var(--spacing-24);
    font-size: var(--text-h3);
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .figures,
    .pair {
      grid-template-columns: repeat(3, 1fr);
    }
    .pair {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
    .intro {
      grid-template-columns: 3fr 9fr;
    }
    .flagship {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
