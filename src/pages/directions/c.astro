---
/**
 * MOCKUP — Direction C, "Night shift".
 * The hero is the dark band: the name in light type on a deep aurora, with the
 * product rising out of it under Clear-glass notes. The suite sits on a pale
 * teal band with a control that breaks the booking on purpose.
 */
import { Picture } from 'astro:assets';
import MockLayout from '../../components/directions/MockLayout.astro';
import Icon from '../../components/Icon.astro';
import desktop from '../../assets/work/clinic-booking-desktop.png';
import phone from '../../assets/work/clinic-booking-phone.png';
import triageShot from '../../assets/work/email-triage.png';
import chatShot from '../../assets/work/clinic-chatbot.png';
import { basics, chips, figures, platform, triage, chatbot, suite } from '../../components/directions/shared';

// The three outcomes, in the words of the clinic platform's own notes.
const outcomes = [
  { id: 'ok', label: 'All goes well', title: 'Booked', tone: 'ok', lines: ['The appointment is created in the diary and a confirmation is emailed.', 'Reception sees it on the dashboard, with payment, notes and actions.'] },
  { id: 'taken', label: 'Slot taken while they pay', title: 'Payment kept', tone: 'warn', lines: ['They keep the payment and get a link to pick another time with the same therapist.', 'If they don’t, they are refunded in full automatically after 7 days.'] },
  { id: 'down', label: 'Diary is down', title: 'Refunded', tone: 'warn', lines: ['Stripe retries for up to two hours.', 'Then a full refund, automatically, an email to the patient and an alert to the clinic.'] },
];
---

<MockLayout name="Night shift" letter="c" night>
  <section class="night hero">
    <div class="aurora-night"></div>
    <div class="m-wrap">
      <p class="label muted">{basics.label}</p>
      <h1 class="m-hero-name">{basics.name}</h1>
      <p class="line">{basics.headline}</p>
      <ul class="chips">{chips.map((c) => <li class="chip">{c}</li>)}</ul>
      <div class="actions">
        <a class="btn btn-night" href="/cv/">View CV</a>
        <a class="btn btn-night-2" href="#suite">Selected work<Icon name="arrow-down" /></a>
      </div>
    </div>
    <div class="m-wrap rise">
      <div class="shot-wrap">
        <div class="browser">
          <div class="browser-bar"><i></i><i></i><i></i><span>cian-clinic-demo.vercel.app</span></div>
          <Picture src={desktop} alt="The demo booking page: choosing a time with a physiotherapist." formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1440, 2000]} sizes="(min-width: 1296px) 1000px, 92vw" loading="eager" />
        </div>
        <div class="phone small"><div class="screen"><Picture src={phone} alt="The demo on a phone: choosing a time." formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 780]} sizes="260px" loading="eager" /></div></div>
        {/* Clear glass over media: small notes that float above the screenshot. */}
        <p class="note n1 glass"><i class="dot"></i>Slot held for 30 minutes</p>
        <p class="note n2 glass"><i class="dot"></i>Paid · booked in the diary</p>
      </div>
    </div>
  </section>

  <section class="m-wrap figures" aria-label="Proof">
    {
      figures.map((f) => (
        <div>
          <p class="m-figure">{f.value}<small>{f.unit}</small></p>
          <p class="cap">{f.label}</p>
        </div>
      ))
    }
  </section>

  <section id="suite" class="band">
    <div class="m-wrap">
      <div class="intro">
        <h2>{suite.name}</h2>
        <p>{suite.summary}</p>
      </div>

      <div class="flagship">
        <div class="phone"><div class="screen"><Picture src={phone} alt="The demo on a phone: choosing a time." formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 780]} sizes="280px" /></div></div>
        <div class="about">
          <h3>{platform.name}</h3>
          <p class="tag">{platform.tagline} {platform.fact}</p>

          <fieldset class="break">
            <legend>Break it on purpose</legend>
            <div class="seg">
              {
                outcomes.map((o, i) => (
                  <label>
                    <input type="radio" name="outcome" value={o.id} checked={i === 0} />
                    <span>{o.label}</span>
                  </label>
                ))
              }
            </div>
            <div class="result" aria-live="polite">
              {
                outcomes.map((o) => (
                  <div class="outcome" data-for={o.id}>
                    <p class:list={['state', o.tone]}>{o.title}</p>
                    {o.lines.map((l) => <p>{l}</p>)}
                  </div>
                ))
              }
            </div>
          </fieldset>
          <a class="btn btn-primary" href="/work/clinic-platform/">Read the case study<Icon name="arrow-right" /></a>
        </div>
      </div>

      <div class="pair">
        {
          [
            { item: triage, shot: triageShot, href: `/work/${triage.slug}/`, cta: 'Read the case study' },
            { item: chatbot, shot: chatShot, href: chatbot.demo, cta: 'Try the demo' },
          ].map(({ item, shot, href, cta }) => (
            <article>
              <div class="browser"><Picture src={shot} alt={item.imageAlt ?? ''} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 960]} sizes="(min-width: 768px) 560px, 92vw" class="shot" /></div>
              <h3>{item.name}</h3>
              <p class="muted2">{item.tagline}</p>
              <a class="m-link" href={href}>{cta}<Icon name="arrow-right" /></a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</MockLayout>

<style>
  .hero {
    margin-top: calc(var(--spacing-64) * -1 - var(--spacing-16));
    padding-top: var(--spacing-128);
    /* The band ends part-way down the screenshot, so the product rises out of it. */
    background: linear-gradient(var(--night) calc(100% - var(--rise)), var(--color-canvas) 0);
    --rise: clamp(64px, 14vw, 200px);
  }
  .hero :global(.aurora-night) {
    bottom: var(--rise);
  }
  .label {
    font-size: var(--text-h3);
  }
  .m-hero-name {
    margin-top: var(--spacing-8);
  }
  .line {
    margin-top: var(--spacing-24);
    max-width: 16em;
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8);
    margin-top: var(--spacing-24);
  }
  .chips .chip {
    border-color: oklch(1 0 0 / 0.28);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-12);
    margin-top: var(--spacing-32);
  }
  .rise {
    position: relative;
    margin-top: var(--spacing-64);
  }
  .shot-wrap {
    position: relative;
    max-width: 1000px;
    margin-left: auto;
  }
  .phone.small {
    display: none;
    width: min(260px, 70vw);
    margin-inline: auto;
  }
  .note {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: var(--spacing-12) var(--spacing-16);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: 500;
    white-space: nowrap;
  }
  .n1 {
    top: 46%;
    left: 34%;
  }
  .n2 {
    top: 20%;
    right: 4%;
  }
  .dot {
    width: var(--spacing-8);
    height: var(--spacing-8);
    border-radius: var(--radius-pill);
    background: var(--color-ok);
  }

  .figures {
    display: grid;
    gap: var(--spacing-32) var(--spacing-48);
    padding-block: var(--spacing-96) var(--spacing-section);
  }
  .figures > div {
    padding-top: var(--spacing-24);
    border-top: 1px solid var(--color-line-strong);
  }
  .m-figure small,
  .cap,
  .muted2 {
    color: var(--color-muted);
  }
  .cap {
    margin-top: var(--spacing-12);
    max-width: 24em;
    font-size: var(--text-small);
  }

  .band {
    padding-block: var(--spacing-section);
    background: oklch(0.95 0.03 195);
  }
  .intro {
    display: grid;
    gap: var(--spacing-12) var(--spacing-24);
    align-items: baseline;
  }
  .intro h2 {
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .intro p {
    max-width: var(--container-prose);
    font-size: var(--text-body-lg);
  }
  .flagship {
    display: grid;
    gap: var(--spacing-48);
    align-items: center;
    margin-top: var(--spacing-64);
  }
  .flagship .phone {
    width: min(280px, 72vw);
    margin-inline: auto;
  }
  .about h3 {
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .tag {
    margin-top: var(--spacing-16);
    max-width: 34em;
    font-size: var(--text-body-lg);
  }
  .break {
    margin-block: var(--spacing-32);
    padding: var(--spacing-20);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-e2);
  }
  legend {
    float: left;
    width: 100%;
    font-weight: 600;
  }
  .seg {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
    margin-top: var(--spacing-12);
    padding: var(--spacing-4);
    border-radius: var(--radius-sm);
    background: var(--color-well);
  }
  .seg label {
    position: relative;
    flex: 1 1 auto;
  }
  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .seg span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--spacing-tap);
    padding-inline: var(--spacing-12);
    border-radius: var(--radius-xs);
    font-size: var(--text-small);
    font-weight: 500;
    white-space: nowrap;
    transition: background-color var(--dur-micro) ease;
  }
  .seg input:checked + span {
    background: var(--color-surface);
    box-shadow: var(--shadow-e1);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* The three outcomes share one grid cell, so switching never moves the page. */
  .result {
    display: grid;
    margin-top: var(--spacing-16);
  }
  .outcome {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .outcome p + p {
    margin-top: var(--spacing-4);
    color: var(--color-muted);
  }
  .state {
    display: inline-block;
    padding: var(--spacing-2) var(--spacing-12);
    border-radius: var(--radius-pill);
    background: var(--color-ok-soft);
    color: var(--color-ok);
    font-size: var(--text-small);
    font-weight: 600;
  }
  .state.warn {
    background: var(--color-warn-soft);
    color: var(--color-warn);
  }
  .break:has(input[value='ok']:checked) .outcome[data-for='ok'],
  .break:has(input[value='taken']:checked) .outcome[data-for='taken'],
  .break:has(input[value='down']:checked) .outcome[data-for='down'] {
    visibility: visible;
    opacity: 1;
  }

  .pair {
    display: grid;
    gap: var(--spacing-48) var(--spacing-24);
    margin-top: var(--spacing-96);
  }
  .pair :global(.shot) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .pair h3 {
    margin-top: var(--spacing-24);
    font-size: var(--text-h3);
    font-weight: 600;
  }
  @media (max-width: 767px) {
    /* On a phone, show the phone. */
    .rise .browser {
      display: none;
    }
    .phone.small {
      display: block;
    }
    .n1 {
      top: 34%;
      left: 0;
    }
    .n2 {
      top: 62%;
      right: 0;
    }
  }
  @media (min-width: 768px) {
    .figures {
      grid-template-columns: repeat(3, 1fr);
    }
    .pair {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .intro {
      grid-template-columns: 3fr 9fr;
    }
    .flagship {
      grid-template-columns: 4fr 8fr;
    }
  }
</style>
