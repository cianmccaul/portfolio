---
/**
 * A case study, written like a design doc: three-line summary, context,
 * decisions with the alternatives rejected, the hardest problem, results and
 * reflection. Facts about the project come from resume.json; the write-up is
 * the MDX file of the same name in content/work/.
 */
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import DashboardPreview from '../../components/DashboardPreview.astro';
import Icon from '../../components/Icon.astro';
import Todo from '../../components/Todo.astro';
import WorkLinks from '../../components/WorkLinks.astro';
import Decision from '../../components/work/Decision.astro';
import Excerpt from '../../components/work/Excerpt.astro';
import Pipeline from '../../components/work/Pipeline.astro';
import Toc from '../../components/work/Toc.astro';
import Shot from '../../components/work/Shot.astro';
import Pending from '../../components/Pending.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import { project, showTodos } from '../../lib/resume';
import { article, breadcrumbs } from '../../lib/seo';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(i + 1) % entries.length] },
  }));
}

const { entry, next } = Astro.props;
const item = project(entry.id);
if (!item.caseStudy) throw new Error(`content/work/${entry.id}.mdx exists but "${entry.id}" is not marked caseStudy in resume.json`);
const nextItem = project(next.id);

const { Content, headings } = await render(entry);

// A section that holds nothing but TODOs is empty in production, where TODOs
// aren't rendered. Leave its heading out too, rather than show a bare title.
const pending = showTodos
  ? []
  : (entry.body ?? '')
      .split(/^## /m)
      .slice(1)
      .filter(
        (section) =>
          section
            .replace(/^.*$/m, '')
            .replace(/<Todo[^>]*\/>/g, '')
            .replace(/<Pending[\s\S]*?<\/Pending>/g, '')
            .trim() === '',
      )
      .map((section) => section.split('\n')[0]!.trim());
const sections = [
  { id: 'tldr', label: 'TL;DR' },
  ...headings
    .filter((h) => h.depth === 2 && !pending.includes(h.text))
    .map((h) => ({ id: h.slug, label: h.text })),
];
const pendingIds = headings.filter((h) => pending.includes(h.text)).map((h) => h.slug);

const minutes = Math.max(1, Math.round((entry.body ?? '').replace(/<[^>]+>|[`*_#>{}\[\]()]/g, ' ').split(/\s+/).length / 220));
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/work/*.png', { eager: true });
const image = item.image ? images[`../../assets/work/${item.image}`]?.default : undefined;
const path = `/work/${entry.id}/`;

// A fact with no value yet is only listed in draft builds, where its TODO shows.
const facts = [
  { term: 'Role', value: item.role, span: 'lg:col-span-2' },
  { term: 'Team', value: entry.data.team, span: 'lg:col-span-2' },
  { term: 'Timeline', value: entry.data.timeline, todo: entry.data.timelineTodo, span: 'lg:col-span-3' },
  { term: 'Stack', value: item.stack.join(', '), span: 'col-span-2 lg:col-span-5' },
].filter((fact) => fact.value || (fact.todo && showTodos));
const tldr = [
  { term: 'Problem', value: entry.data.tldr.problem },
  { term: 'What I did', value: entry.data.tldr.approach },
  { term: 'Result', value: entry.data.tldr.result, todo: entry.data.tldr.resultTodo, pending: entry.data.tldr.resultPending },
];
---

<Base
  title={`Case study: ${item.name}`}
  description={entry.data.description}
  og={`work-${entry.id}`}
  schema={[
    article(item.name, entry.data.description, path),
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Work', path: '/#work' },
      { name: item.name, path },
    ]),
  ]}
>
  <article class="mx-auto max-w-page px-gutter pt-64 lg:pt-96">
    <header>
      <nav aria-label="Breadcrumb" class="text-small text-muted">
        <ol class="flex items-center gap-8">
          <li><a href="/#work" class="link">Work</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Case study</li>
        </ol>
      </nav>
      <h1 class="mt-16 text-h1">{item.name}</h1>
      <p class="mt-12 max-w-prose text-body-lg text-muted">{item.tagline}</p>

      <dl class="mt-32 grid grid-cols-2 gap-x-24 border-y border-line lg:grid-cols-12">
        {
          facts.map((fact) => (
            <div class:list={['py-16', fact.span]}>
              <dt class="text-caption text-muted">{fact.term}</dt>
              <dd class="mt-2 text-small">
                {fact.value}
                {fact.todo && <Todo text={fact.todo} class={fact.value ? 'ml-4' : ''} />}
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-8 flex flex-wrap items-center justify-between gap-x-24">
        <WorkLinks project={item} caseStudyLink={false} />
        <p class="text-small text-muted">{minutes} min read</p>
      </div>
      {entry.data.approvalTodo && <Todo block text={entry.data.approvalTodo} class="mt-8 max-w-prose" />}
    </header>

    {
      entry.id === 'clinic-platform' ? (
        <div class="mt-24 grid place-items-center rounded-md bg-well p-12 sm:p-32 lg:p-64">
          <div class="w-full max-w-card-wide">
            <DashboardPreview />
          </div>
        </div>
      ) : image && item.imageCaption ? (
        <BrowserFrame src={image} alt={item.imageAlt ?? ''} caption={item.imageCaption} eager class="mt-24" />
      ) : (
        image && (
          <div class="media mt-24 overflow-hidden rounded-md border border-line bg-well">
            <Picture
              src={image}
              alt={item.imageAlt ?? ''}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 720, 960, 1280, 1746]}
              sizes="(min-width: 1296px) 1200px, 92vw"
              class="aspect-16/10 w-full object-cover object-top"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      )
    }

    <div class="mt-48 grid gap-x-24 gap-y-16 lg:mt-64 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-3">
        <Toc items={sections} />
      </div>

      {/* min-w-0 lets code blocks scroll inside the column instead of widening it. */}
      <div class="min-w-0 lg:col-span-9">
        <section id="tldr" aria-labelledby="tldr-title">
          <h2 id="tldr-title" class="text-h2">TL;DR</h2>
          <dl class="mt-24">
            {
              tldr.map((line) => (
                <div class="grid gap-x-24 gap-y-4 border-t border-line py-16 lg:grid-cols-9">
                  <dt class="text-small font-semibold lg:col-span-2 lg:pt-2">{line.term}</dt>
                  <dd class="max-w-prose lg:col-span-7">
                    {line.value}
                    {line.pending && (
                      <Pending approval={line.pending.approval} class="mt-12">
                        <p>{line.pending.text}</p>
                      </Pending>
                    )}
                    {line.todo && <Todo block text={line.todo} class="mt-12" />}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <div class="prose mt-section">
          <Content components={{ Todo, Decision, Excerpt, Pipeline, Pending, Shot }} />
        </div>
        {pendingIds.length > 0 && <style set:html={pendingIds.map((id) => `#${id}{display:none}`).join('')} />}
      </div>
    </div>

    <aside aria-label="Next case study" class="mt-section">
      <a
        href={`/work/${next.id}/`}
        class="group flex items-center justify-between gap-24 rounded-md border border-line bg-surface p-24 shadow-e1 transition-colors duration-(--dur-micro) hover:bg-well sm:p-32"
      >
        <span>
          <span class="block text-small text-muted">Next case study</span>
          <span class="mt-4 block text-h2">{nextItem.name}</span>
          <span class="mt-4 block text-muted">{nextItem.tagline}</span>
        </span>
        <Icon name="arrow-right" size={24} class="text-muted transition-transform duration-(--dur-fast) ease-out group-hover:translate-x-4" />
      </a>
    </aside>
  </article>
</Base>
