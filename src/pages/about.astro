---
/**
 * The longer story. The H1 is the full name, so a search for it lands here.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionRail from '../components/SectionRail.astro';
import SpecSheet from '../components/SpecSheet.astro';
import Todo from '../components/Todo.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/cian.jpg';
import { resume } from '../lib/resume';
import { logisticsSpecs } from '../lib/specs';
import { profilePage, breadcrumbs } from '../lib/seo';

const { basics } = resume;
const beyond = resume.interests.filter((interest) => interest.featured);
---

<Base
  title="About"
  description={`About ${basics.name}: ${basics.label}, living in ${basics.location.city}.`}
  og="about"
  schema={[profilePage(), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }])]}
>
  <PageHeader title={basics.name} kicker={basics.label}>
    <div class="grid gap-x-48 gap-y-32 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="grid max-w-prose gap-16 text-body-lg">
          {basics.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="mt-32 flex flex-wrap gap-12">
          <a class="btn btn-primary" href="/cv/">View CV</a>
          <a class="btn btn-secondary" href="/#work">Selected work<Icon name="arrow-right" /></a>
        </div>
      </div>
      <aside class="max-lg:order-first lg:col-span-5" aria-label="At a glance">
        <Image
          src={portrait}
          alt={`${basics.name} in a navy suit outside O’Reilly Hall, UCD`}
          width={240}
          height={240}
          loading="eager"
          class="size-128 rounded-md object-cover lg:size-160"
        />
        <Todo
          block
          text="A high-resolution portrait, 4:5. This one is 240 px square, so it is shown small."
          class="mt-16"
        />
        <SpecSheet items={logisticsSpecs} compact class="mt-24" />
      </aside>
    </div>
  </PageHeader>

  <SectionRail id="beyond" title="Beyond the code">
    <ul>
      {
        beyond.map((interest) => (
          <li class="grid gap-x-24 gap-y-4 border-line py-24 not-first:border-t first:pt-0 lg:grid-cols-9">
            <h3 class="text-h3 lg:col-span-3">{interest.name}</h3>
            <p class="max-w-prose lg:col-span-6">{interest.summary}</p>
          </li>
        ))
      }
    </ul>
  </SectionRail>
</Base>
