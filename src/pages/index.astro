---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import MoreProjects from '../components/MoreProjects.astro';
import Experience from '../components/Experience.astro';
import Testimonials from '../components/Testimonials.astro';
import Education from '../components/Education.astro';
import { resume } from '../lib/resume';
import { profilePage } from '../lib/seo';

const { basics } = resume;
const description = `${basics.name}, ${basics.label}. ${basics.summary.replace(/\*\*/g, '')}`;
---

<Base title={`${basics.name} · ${basics.label}`} description={description} og="home" schema={[profilePage()]}>
  <Hero />
  <SelectedWork />
  <MoreProjects />
  <Experience />
  <Testimonials />
  <Education />
</Base>
