---
/**
 * The page's recurring layout: the section title sits in a left rail (three of
 * twelve columns) and the content takes the other nine. Stacked on small
 * screens.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="mx-auto max-w-page px-gutter pt-section">
  <div class="grid gap-x-24 gap-y-24 lg:grid-cols-12">
    <h2 id={`${id}-title`} class="text-h2 lg:col-span-3">{title}</h2>
    <div class="lg:col-span-9">
      <slot />
    </div>
  </div>
</section>
