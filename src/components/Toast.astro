---
/**
 * Copy-to-clipboard with a confirmation. Any element with data-copy copies its
 * value; the toast is a polite live region so screen readers hear it too.
 * Without JavaScript the same controls are plain links to the contact section.
 */
---

<div
  id="toast"
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed inset-x-0 bottom-24 z-50 flex justify-center px-gutter print:hidden"
>
  <p
    class="toast glass glass-1 translate-y-8 rounded-pill px-20 py-12 text-small font-medium opacity-0 data-[open]:translate-y-0 data-[open]:opacity-100"
  >
  </p>
</div>

<script>
  const message = document.querySelector<HTMLElement>('#toast p');
  let timer: number | undefined;

  function toast(text: string) {
    if (!message) return;
    message.textContent = text;
    message.dataset.open = '';
    window.clearTimeout(timer);
    timer = window.setTimeout(() => delete message.dataset.open, 2400);
  }

  document.addEventListener('click', async (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-copy]');
    if (!trigger) return;
    event.preventDefault();
    const value = trigger.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(value);
      toast(trigger.dataset.copied ?? 'Copied');
    } catch {
      toast(`Couldn’t copy. It’s ${value}`);
    }
  });
</script>

<style>
  /* The glass class already transitions colour; add the toast's own entrance. */
  .toast {
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) ease;
  }
</style>
