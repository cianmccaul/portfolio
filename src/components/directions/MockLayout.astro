---
/**
 * DESIGN-DIRECTION MOCKUP shell — temporary, not part of the site.
 * A glass nav that sits over each direction's backdrop, and a switcher.
 */
import '../../styles/global.css';
import './mock.css';
import fontUrl from '../../assets/fonts/InterVariable-latin.woff2?url';
import Monogram from '../Monogram.astro';

interface Props {
  name: string;
  letter: 'a' | 'b' | 'c';
  /** Dark hero: the nav uses the dark glass. */
  night?: boolean;
}
const { name, letter, night = false } = Astro.props;
const directions = [
  { letter: 'a', name: 'Front desk' },
  { letter: 'b', name: 'Broadsheet' },
  { letter: 'c', name: 'Night shift' },
];
---

<!doctype html>
<html lang="en-IE" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`Direction ${letter.toUpperCase()}: ${name} · mockup`}</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="m-nav">
      <nav aria-label="Main" class={night ? 'glass-night' : 'glass'}>
        <a href="/" class="mark" aria-label="Home"><Monogram size={32} /></a>
        <a href="#suite">Work</a>
        <a href="/about/">About</a>
        <a href="/cv/">CV</a>
        <kbd class="m-kbd">⌘K</kbd>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <nav class="m-switch" aria-label="Design directions">
      {
        directions.map((d) => (
          <a href={`/directions/${d.letter}/`} aria-current={d.letter === letter ? 'page' : undefined}>
            {d.letter.toUpperCase()} · {d.name}
          </a>
        ))
      }
    </nav>
  </body>
</html>
