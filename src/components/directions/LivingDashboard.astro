---
/**
 * MOCKUP of the signature moment: a reception dashboard that is alive.
 * Two bookings arrive, the list moves up to make room and the counts tick.
 * Every motion is transform or opacity, 280 ms or less, inside fixed-height
 * boxes, so nothing shifts. It plays once when scrolled into view (under five
 * seconds in total), can be replayed, and under reduced motion simply shows
 * the end state. All names and figures are sample data.
 */
const rows = [
  { time: '09:00', patient: 'Emma Nolan', service: 'Physiotherapy', payment: 'Paid', tone: 'ok' },
  { time: '09:30', patient: 'Liam O’Brien', service: 'Sports massage', payment: 'Deposit only', tone: 'warn' },
  { time: '10:15', patient: 'Grace Kinsella', service: 'Physio and shockwave', payment: 'Paid', tone: 'ok' },
  { time: '11:00', patient: 'Daniel Farrell', service: 'Initial assessment', payment: 'Paid', tone: 'ok' },
  { time: '11:30', patient: 'Aoife Byrne', service: 'Sports massage', payment: 'Paid', tone: 'ok' },
  { time: '12:15', patient: 'Seán Murphy', service: 'Physiotherapy', payment: 'Paid', tone: 'ok' },
];
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure class:list={['live', className]} data-live>
  <figcaption>
    <span class="title">Day overview</span>
    <span class="note">Reception dashboard, sample data</span>
  </figcaption>

  <ul class="tiles">
    <li><span class="label">Booked</span><b data-count="booked">14</b><span class="ok">Up 2 on last week</span></li>
    <li><span class="label">Paid in full</span><b data-count="paid">11</b><span class="ok" data-of>of 14 booked</span></li>
    <li class="third"><span class="label">Still to collect</span><b>€130</b><span class="warn">3 patients</span></li>
  </ul>

  <div class="head" aria-hidden="true"><span>Time</span><span>Patient</span><span class="svc">Service</span><span>Payment</span></div>
  <div class="viewport">
    <ol data-rows>
      {
        rows.map((row) => (
          <li>
            <span class="time">{row.time}</span>
            <span>{row.patient}</span>
            <span class="svc">{row.service}</span>
            <span><i class={row.tone}>{row.payment}</i></span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="toast glass" data-toast aria-hidden="true"><i class="dot"></i><span data-toast-text>New booking · 11:30 · paid online</span></p>
  <button type="button" class="replay" data-replay>Replay</button>
</figure>

<script>
  const ARRIVALS = [
    { at: 900, booked: 15, paid: 12, toast: 'New booking · 11:30 · paid online' },
    { at: 2900, booked: 16, paid: 13, toast: 'New booking · 12:15 · paid online' },
  ];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-live]')) {
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    const booked = root.querySelector<HTMLElement>('[data-count="booked"]')!;
    const paid = root.querySelector<HTMLElement>('[data-count="paid"]')!;
    const of = root.querySelector<HTMLElement>('[data-of]')!;
    const toast = root.querySelector<HTMLElement>('[data-toast]')!;
    const toastText = root.querySelector<HTMLElement>('[data-toast-text]')!;
    let timers: number[] = [];

    const tick = (el: HTMLElement, value: string) => {
      el.textContent = value;
      el.classList.remove('tick');
      void el.offsetWidth; // restart the keyframes
      el.classList.add('tick');
    };
    const show = (step: number, animate: boolean) => {
      rows.style.transition = animate ? '' : 'none';
      rows.style.setProperty('--shift', String(step));
      const state = step === 0 ? { booked: 14, paid: 11 } : ARRIVALS[step - 1]!;
      if (animate) {
        tick(booked, String(state.booked));
        tick(paid, String(state.paid));
      } else {
        booked.textContent = String(state.booked);
        paid.textContent = String(state.paid);
      }
      of.textContent = `of ${state.booked} booked`;
    };
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      toast.removeAttribute('data-open');
      if (reduced.matches) return show(ARRIVALS.length, false);
      show(0, false);
      ARRIVALS.forEach((arrival, i) => {
        timers.push(
          window.setTimeout(() => {
            show(i + 1, true);
            toastText.textContent = arrival.toast;
            toast.setAttribute('data-open', '');
          }, arrival.at),
          window.setTimeout(() => toast.removeAttribute('data-open'), arrival.at + 1500),
        );
      });
    };

    root.querySelector('[data-replay]')!.addEventListener('click', play);
    new IntersectionObserver(
      (entries, observer) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          play();
        }
      },
      { threshold: 0.6 },
    ).observe(root);
  }
</script>

<style>
  .live {
    --row: 44px;
    position: relative;
    padding: var(--spacing-20);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-ink);
    text-align: left;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--spacing-16);
  }
  .title {
    font-size: var(--text-h3);
    font-weight: 600;
  }
  .note,
  .label,
  .head,
  .ok,
  .warn {
    font-size: var(--text-caption);
  }
  .note,
  .label,
  .head {
    color: var(--color-muted);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-8);
    margin-top: var(--spacing-16);
  }
  .tiles li {
    display: grid;
    padding: var(--spacing-12);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xs);
  }
  .tiles b {
    height: 1.15em;
    overflow: hidden;
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
  }
  .ok {
    color: var(--color-ok);
  }
  .warn {
    color: var(--color-warn);
  }
  .head,
  ol li {
    display: grid;
    grid-template-columns: 56px 1.1fr 1.3fr 112px;
    gap: var(--spacing-12);
    align-items: center;
  }
  .head {
    margin-top: var(--spacing-16);
    padding-bottom: var(--spacing-8);
    border-bottom: 1px solid var(--color-line);
    font-weight: 500;
  }
  /* Four rows tall, always. Later rows wait below, out of sight. */
  .viewport {
    height: calc(var(--row) * 4);
    overflow: hidden;
  }
  ol {
    transform: translateY(calc(var(--shift, 0) * var(--row) * -1));
    transition: transform var(--dur-slow) var(--ease-out);
  }
  ol li {
    height: var(--row);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-small);
    white-space: nowrap;
  }
  ol li span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .time {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .svc {
    color: var(--color-muted);
  }
  ol i {
    display: inline-block;
    padding: var(--spacing-2) var(--spacing-8);
    border-radius: var(--radius-pill);
    background: var(--color-ok-soft);
    color: var(--color-ok);
    font-size: var(--text-caption);
    font-style: normal;
  }
  ol i.warn {
    background: var(--color-warn-soft);
    color: var(--color-warn);
  }
  :global(.tick) {
    animation: tick var(--dur-base) var(--ease-out);
  }
  @keyframes tick {
    from {
      opacity: 0;
      transform: translateY(40%);
    }
  }

  /* A small Clear-glass note that floats over the dashboard, never under text you need. */
  .toast {
    position: absolute;
    right: var(--spacing-12);
    bottom: calc(var(--spacing-48) * -0.5);
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: var(--spacing-12) var(--spacing-16);
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .toast[data-open] {
    opacity: 1;
    transform: none;
  }
  .dot {
    width: var(--spacing-8);
    height: var(--spacing-8);
    border-radius: var(--radius-pill);
    background: var(--color-ok);
  }
  .replay {
    position: absolute;
    left: var(--spacing-20);
    bottom: calc(var(--spacing-48) * -1);
    min-height: var(--spacing-tap);
    color: var(--replay-color, var(--color-muted));
    font-size: var(--text-caption);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .live {
      padding: var(--spacing-16);
    }
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
    .third,
    .svc {
      display: none;
    }
    .head,
    ol li {
      grid-template-columns: 48px 1fr auto;
    }
  }
</style>
