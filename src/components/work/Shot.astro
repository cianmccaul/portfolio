---
/** A screenshot from src/assets/work/ inside a case study, in a browser frame. */
import type { ImageMetadata } from 'astro';
import BrowserFrame from '../BrowserFrame.astro';
interface Props {
  file: string;
  alt: string;
  caption?: string;
}
const { file, alt, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/work/*.png', { eager: true });
const src = images[`../../assets/work/${file}`]?.default;
if (!src) throw new Error(`No image src/assets/work/${file}`);
---

<BrowserFrame src={src} alt={alt} caption={caption} maxWidth={880} class="my-32" />
