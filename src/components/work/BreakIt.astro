---
/**
 * "Break it on purpose": the clinic case study's signature moment. Pick what
 * goes wrong during a booking and see where the patient and their money end
 * up. Three native radio buttons and CSS, no script; the three outcomes share
 * one grid cell, so switching never moves the page.
 *
 * The outcomes are the ones in the pipeline above it, in plain words.
 */
const outcomes = [
  {
    id: 'ok',
    label: 'All goes well',
    title: 'Booked',
    tone: 'ok',
    lines: [
      'The appointment is created in the diary and a confirmation is emailed.',
      'Reception sees it on the dashboard, with payment, notes and actions.',
    ],
  },
  {
    id: 'taken',
    label: 'Slot taken while they pay',
    title: 'Payment kept',
    tone: 'warn',
    lines: [
      'They keep the payment and get a link to pick another time with the same therapist.',
      'If they don’t, they are refunded in full automatically after 7 days.',
    ],
  },
  {
    id: 'down',
    label: 'Diary is down',
    title: 'Refunded',
    tone: 'warn',
    lines: [
      'Stripe retries for up to two hours.',
      'Then a full refund, automatically, an email to the patient and an alert to the clinic.',
    ],
  },
];
---

<div class="night not-prose break my-48 overflow-clip rounded-md">
  <div class="night-glow" aria-hidden="true"></div>
  <fieldset>
    <legend>Break it on purpose</legend>
    <p class="intro">A patient has just paid. Choose what happens next.</p>
    <div class="seg">
      {
        outcomes.map((outcome, i) => (
          <label>
            <input type="radio" name="break-it" value={outcome.id} checked={i === 0} />
            <span>{outcome.label}</span>
          </label>
        ))
      }
    </div>
    <div class="result">
      {
        outcomes.map((outcome) => (
          <div class="outcome" data-for={outcome.id}>
            <p class:list={['state', outcome.tone]}>{outcome.title}</p>
            <p class="first">{outcome.lines[0]}</p>
            <p class="then">{outcome.lines[1]}</p>
          </div>
        ))
      }
    </div>
  </fieldset>
</div>

<style>
  fieldset {
    padding: var(--spacing-24);
  }
  legend {
    float: left;
    width: 100%;
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
  }
  .intro {
    clear: both;
    padding-top: var(--spacing-8);
    color: var(--color-muted);
  }
  .seg {
    display: grid;
    gap: var(--spacing-4);
    margin-top: var(--spacing-24);
    padding: var(--spacing-4);
    border-radius: var(--radius-sm);
    background-color: oklch(1 0 0 / 0.08);
  }
  .seg label {
    position: relative;
  }
  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .seg span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--spacing-tap);
    padding-inline: var(--spacing-12);
    border-radius: calc(var(--radius-sm) - var(--spacing-4));
    font-size: var(--text-small);
    font-weight: 500;
    text-align: center;
    transition:
      background-color var(--dur-micro) ease,
      color var(--dur-micro) ease;
  }
  .seg input:checked + span {
    background-color: var(--color-ink);
    color: var(--color-night);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .result {
    display: grid;
    margin-top: var(--spacing-24);
    padding-top: var(--spacing-24);
    border-top: 1px solid var(--color-line);
  }
  .outcome {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--dur-base) var(--ease-out),
      visibility 0s var(--dur-base);
  }
  .state {
    display: inline-block;
    padding: var(--spacing-4) var(--spacing-12);
    border-radius: var(--radius-pill);
    background-color: var(--color-ok-soft);
    color: var(--color-ok);
    font-size: var(--text-small);
    font-weight: 600;
  }
  .state.warn {
    background-color: var(--color-warn-soft);
    color: var(--color-warn);
  }
  .first {
    margin-top: var(--spacing-12);
    max-width: var(--container-prose);
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
  }
  .then {
    margin-top: var(--spacing-4);
    max-width: var(--container-prose);
    color: var(--color-muted);
  }
  .break:has(input[value='ok']:checked) .outcome[data-for='ok'],
  .break:has(input[value='taken']:checked) .outcome[data-for='taken'],
  .break:has(input[value='down']:checked) .outcome[data-for='down'] {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }
  /* Without :has(), show all three as a plain list. */
  @supports not selector(:has(*)) {
    .seg {
      display: none;
    }
    .outcome {
      grid-area: auto;
      visibility: visible;
      opacity: 1;
      padding-bottom: var(--spacing-16);
    }
  }
  @media (min-width: 640px) {
    fieldset {
      padding: var(--spacing-40);
    }
    .seg {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
