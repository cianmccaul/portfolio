---
/**
 * The clinic platform's reception dashboard, drawn in HTML with sample data.
 * It is labelled as sample data in the caption: none of these patients or
 * figures are real.
 */
const tiles = [
  { label: 'Booked', value: '14', note: 'Up 2 on last week', tone: 'ok' },
  { label: 'Paid in full', value: '11', note: 'of 14 booked', tone: 'ok' },
  { label: 'Still to collect', value: '€130', note: '3 patients', tone: 'warn' },
];
const rows = [
  { time: '09:00', patient: 'Emma Nolan', service: 'Physiotherapy', payment: 'Paid', tone: 'ok' },
  { time: '09:30', patient: 'Liam O’Brien', service: 'Sports massage', payment: 'Deposit only', tone: 'warn' },
  { time: '10:15', patient: 'Grace Kinsella', service: 'Physio and shockwave', payment: 'Paid', tone: 'ok' },
  { time: '11:00', patient: 'Daniel Farrell', service: 'Initial assessment', payment: 'Paid', tone: 'ok' },
];
---

<figure class="w-full rounded-sm border border-line bg-surface p-16 shadow-e2 sm:p-24">
  <figcaption class="flex flex-col gap-x-16 sm:flex-row sm:items-baseline sm:justify-between">
    <span class="text-h3 font-semibold">Day overview</span>
    <span class="text-caption text-muted">Reception dashboard, sample data</span>
  </figcaption>

  <ul class="mt-16 grid grid-cols-2 gap-8 sm:grid-cols-3">
    {
      tiles.map((tile, i) => (
        <li class:list={['rounded-xs border border-line p-12', i === 2 && 'max-sm:hidden']}>
          <p class="text-caption text-muted">{tile.label}</p>
          <p class="text-h2 tabular-nums">{tile.value}</p>
          <p class:list={['text-caption', tile.tone === 'warn' ? 'text-warn' : 'text-ok']}>{tile.note}</p>
        </li>
      ))
    }
  </ul>

  <table class="mt-16 w-full text-left text-small">
    <thead>
      <tr class="border-b border-line text-caption text-muted">
        <th scope="col" class="py-8 pr-12 font-medium">Time</th>
        <th scope="col" class="py-8 pr-12 font-medium">Patient</th>
        <th scope="col" class="py-8 pr-12 font-medium max-sm:hidden">Service</th>
        <th scope="col" class="py-8 font-medium">Payment</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-b border-line last:border-b-0">
            <td class="py-8 pr-12 font-medium tabular-nums">{row.time}</td>
            <td class="py-8 pr-12 whitespace-nowrap">{row.patient}</td>
            <td class="py-8 pr-12 text-muted max-sm:hidden">{row.service}</td>
            <td class="py-8">
              <span
                class:list={[
                  'inline-block rounded-pill px-8 py-2 text-caption whitespace-nowrap',
                  row.tone === 'warn' ? 'bg-warn-soft text-warn' : 'bg-ok-soft text-ok',
                ]}
              >
                {row.payment}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>
