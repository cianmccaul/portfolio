---
import Icon from './Icon.astro';
interface Props {
  href: string;
  /** Standalone links get a 44 px touch target. */
  action?: boolean;
  /** rel="me" marks a profile as the same person, for identity verification. */
  rel?: string;
  class?: string;
}
const { href, action = false, rel, class: className } = Astro.props;
---

<a href={href} rel={rel} class:list={['link', action ? 'link-action' : 'inline-flex items-center gap-2', className]}>
  <slot /><Icon name="arrow-up-right" size={16} />
</a>
