---
/**
 * One icon set at one stroke weight (Lucide geometry, 24 px grid, 1.75 stroke).
 * Brand marks, and the half-filled appearance disc, are the only filled icons. Always decorative: the control that
 * holds an icon carries the label.
 */
interface Props {
  name: keyof typeof icons;
  size?: 16 | 20 | 24;
  class?: string;
}

const icons = {
