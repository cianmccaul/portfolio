---
/**
 * The case study's hero, on the night band: the name, one line, the three
 * numbers, and where to try it. The Hub's home screen from the public demo
 * sits across the band's lower edge, half on the dark and half on the page.
 */
import BrowserFrame from '../BrowserFrame.astro';
import Icon from '../Icon.astro';
import Todo from '../Todo.astro';
import { hub, hubProject, moduleCount } from '../../lib/hub';
import { workImage, workImageMobile } from '../../lib/images';
import { formatDate } from '../../lib/dates';
import { resume } from '../../lib/resume';

const item = hubProject;
// The clinic's own award, from its experience entry in resume.json.
const recognition = resume.work.find((role) => item.client?.startsWith(role.company))?.recognition?.text;
const image = workImage(hub.hero.image);
const small = [...hub.smallStats, `${moduleCount.live} modules live`];
const host = (url: string) => new URL(url).host;
---

<header class="hero night" data-night>
  <div class="night-glow" aria-hidden="true"></div>
  <div class="mx-auto max-w-page px-gutter pt-32 lg:pt-48">
    <nav aria-label="Breadcrumb" class="text-small font-medium text-muted lg:text-body">
      <ol class="flex items-center gap-8">
        <li><a href="/#work" class="link">Work</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">Case study</li>
      </ol>
    </nav>
    <h1 class="mt-8 text-hero lg:mt-12" style={`view-transition-name: title-${item.slug}`}>{item.name}</h1>
    <p class="mt-20 max-w-prose text-h2 lg:mt-24">{item.tagline}</p>
    {
      item.liveSince && (
        <p class="mt-12 text-body-lg text-muted">
          Live since <time datetime={item.liveSince}>{formatDate(item.liveSince, 'long')}</time>.
        </p>
      )
    }
    {recognition && <p class="mt-8 max-w-prose text-body-lg text-muted">{recognition}</p>}

    <dl class="stats mt-32 border-y border-line lg:mt-48">
      {
        hub.stats.map((stat) => (
          <div>
            <dt class="mt-4 text-body-lg text-muted">{stat.unit}</dt>
            <dd class="text-display tabular-nums">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-12 text-small text-muted">{small.join(' · ')}</p>

    <div class="mt-32 flex flex-wrap gap-12">
      {
        item.demo && (
          <a class="btn btn-primary" href={item.demo}>
            Try the demo<Icon name="arrow-up-right" />
          </a>
        )
      }
      {
        item.live && (
          <a class="btn btn-secondary" href={item.live}>
            {host(item.live)}<Icon name="arrow-up-right" />
          </a>
        )
      }
      <a class="btn btn-secondary" href={item.repo}>
        Code<span class="sr-only"> for the public demo</span><Icon name="arrow-up-right" />
      </a>
    </div>
    <p class="mt-12 max-w-prose text-small text-muted">
      The production code is private. The demo and its code are public, and run as a fictional clinic.
    </p>
    {hub.approvalTodo && <Todo block text={hub.approvalTodo} class="mt-16 max-w-prose" />}

  </div>
</header>
{
  image && (
    <div class="shot mx-auto max-w-page px-gutter">
      <BrowserFrame
        src={image}
        mobile={workImageMobile(hub.hero.image)}
        alt={hub.hero.alt}
        maxWidth={1104}
        eager
        transitionName={`work-${item.slug}`}
      >
        {/* A silent walkthrough of the demo, laid over the screenshot, which
            is its poster. It only loads on wider screens, once it is in view,
            and never under reduced motion (see the script below). */}
        <video class="walk" muted loop playsinline preload="none" data-walk aria-label={hub.hero.videoLabel}>
          <source data-src={`${hub.hero.video}.webm`} type="video/webm" />
          <source data-src={`${hub.hero.video}.mp4`} type="video/mp4" />
        </video>
      </BrowserFrame>
      <div class="mt-8 flex items-start justify-between gap-16">
        <p class="text-small text-muted">{hub.hero.caption}</p>
        <button type="button" class="toggle" data-walk-toggle hidden>
          <span data-when="playing"><Icon name="pause" />Pause<span class="sr-only"> the walkthrough</span></span>
          <span data-when="paused"><Icon name="play" />Play<span class="sr-only"> the walkthrough</span></span>
        </button>
      </div>
    </div>
  )
}

<script>
  // The walkthrough plays only when it can be watched comfortably: a screen
  // wide enough for a desktop recording, motion allowed, no data saver, and
  // the frame in view. It can always be paused, and stays paused once it is.
  const video = document.querySelector<HTMLVideoElement>('[data-walk]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-walk-toggle]');
  if (video && toggle) {
    const wide = window.matchMedia('(min-width: 640px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saver = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const allowed = () => wide.matches && !reduced.matches && !saver;
    let wanted = true;
    let inView = false;
    const update = async () => {
      toggle.hidden = !allowed();
      if (allowed() && wanted && inView) {
        if (!video.dataset.loaded) {
          video.dataset.loaded = '';
          for (const source of video.querySelectorAll('source')) source.src = source.dataset.src!;
          video.load();
        }
        await video.play().catch(() => {});
      } else video.pause();
      toggle.dataset.state = video.paused ? 'paused' : 'playing';
    };
    video.addEventListener('playing', () => (video.dataset.on = ''));
    toggle.addEventListener('click', () => {
      wanted = video.paused;
      update();
    });
    new IntersectionObserver(
      ([entry]) => {
        inView = !!entry?.isIntersecting;
        update();
      },
      { threshold: 0.5 },
    ).observe(video);
    wide.addEventListener('change', update);
    reduced.addEventListener('change', update);
  }
</script>

<style>
  .walk {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-base) ease;
  }
  .walk[data-on] {
    opacity: 1;
  }
  .toggle {
    flex: none;
    min-height: var(--spacing-tap);
    margin-top: calc(var(--spacing-12) * -1);
    color: var(--color-muted);
    font-size: var(--text-small);
    font-weight: 500;
    cursor: pointer;
    transition: color var(--dur-micro) ease;
  }
  .toggle[hidden] {
    display: none;
  }
  .toggle span[data-when] {
    display: none;
    align-items: center;
    gap: var(--spacing-8);
  }
  .toggle[data-state='playing'] [data-when='playing'],
  .toggle[data-state='paused'] [data-when='paused'] {
    display: inline-flex;
  }
  @media (hover: hover) {
    .toggle:hover {
      color: var(--color-ink);
    }
  }
  /* The recording is of a desktop; on a phone the screenshot stands alone. */
  @media (max-width: 639px), (prefers-reduced-motion: reduce) {
    .walk {
      display: none;
    }
  }

  /* The screenshot straddles the band's lower edge: the band leaves room for
     its top part, and the picture is pulled up into it. */
  .hero {
    --overlap: clamp(72px, 20vw, 260px);
    margin-top: calc(var(--nav-h) * -1);
    padding-top: var(--nav-h);
    padding-bottom: calc(var(--overlap) + var(--spacing-48));
  }
  .shot {
    position: relative;
    margin-top: calc(clamp(72px, 20vw, 260px) * -1);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding-block: var(--spacing-20);
  }
  .stats > div + div {
    padding-left: var(--spacing-12);
    border-left: 1px solid var(--color-line);
  }
  /* On a phone the last label is the longest ("scheduled jobs"), so its
     column gets the spare width and the labels drop a size. */
  @media (max-width: 639px) {
    .stats {
      grid-template-columns: 1fr 1fr 1.35fr;
    }
    .stats dt {
      font-size: var(--text-small);
      line-height: var(--text-small--line-height);
      white-space: nowrap;
    }
  }
  @media (min-width: 640px) {
    .stats > div + div {
      padding-left: var(--spacing-32);
    }
  }
</style>
