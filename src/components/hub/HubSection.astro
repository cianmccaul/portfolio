---
/**
 * One section of the BodyMed Hub case study: a rule, the title on the left
 * and a short lede on the right, then the section's own content at the full
 * width of the column.
 */
interface Props {
  id: string;
  title: string;
  lede?: string;
}
const { id, title, lede } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="mx-auto max-w-page px-gutter pt-section">
  <div class="grid gap-x-48 gap-y-12 border-t border-ink pt-24 lg:grid-cols-12">
    <h2 id={`${id}-title`} class="text-h1 lg:col-span-5">{title}</h2>
    {lede && <p class="max-w-prose text-body-lg text-muted lg:col-span-7 lg:pt-8">{lede}</p>}
  </div>
  <div class="mt-32 lg:mt-48">
    <slot />
  </div>
</section>
