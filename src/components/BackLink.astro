---
/**
 * "Back": returns the visitor to exactly where they clicked from.
 *
 * When the previous page was on this site, it goes back in history, so the
 * browser restores that page's scroll position (and plays the page
 * transition). Section jumps made on this page (the "On this page" links)
 * are skipped, so Back never just scrolls to the previous section. On a
 * direct visit or from another site it is an ordinary link to the top of
 * the home page, which is also what it is without JavaScript.
 */
import Icon from './Icon.astro';
interface Props {
  /** Shown after the link, e.g. "Case study". */
  label?: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<p class:list={['flex items-center gap-12 text-small font-medium text-muted lg:text-body', className]}>
  <a href="/" class="link link-action -ml-4 gap-8 px-4" data-back>
    <Icon name="arrow-left" />Back
  </a>
  {
    label && (
      <>
        <span aria-hidden="true" class="text-line-strong">
          /
        </span>
        <span>{label}</span>
      </>
    )
  }
</p>

<script>
  // How many history entries this page has added by itself (section jumps).
  const KEY = 'backDepth';
  let depth = (history.state as Record<string, number> | null)?.[KEY] ?? 0;
  if (history.state?.[KEY] === undefined) history.replaceState({ ...(history.state ?? {}), [KEY]: depth }, '');
  addEventListener('hashchange', () => {
    const known = (history.state as Record<string, number> | null)?.[KEY];
    if (known === undefined) {
      depth += 1;
      history.replaceState({ ...(history.state ?? {}), [KEY]: depth }, '');
    } else depth = known;
  });

  const cameFromHere = () => {
    try {
      return !!document.referrer && new URL(document.referrer).origin === location.origin && history.length > 1;
    } catch {
      return false;
    }
  };
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-back]')) {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      if (!cameFromHere()) return; // a plain link to the top of the home page
      event.preventDefault();
      history.go(-(depth + 1));
    });
  }
</script>
