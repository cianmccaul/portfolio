---
/**
 * Three facts under the hero, each linked to where the site backs it up. They
 * are worked out from resume.json (see `proof` in src/lib/specs.ts) and are
 * deliberately different from the BodyMed Hub numbers in the clinic band.
 */
import Icon from './Icon.astro';
import { proof } from '../lib/specs';
---

{
  proof.length > 0 && (
    <section aria-label="At a glance" class="mx-auto mt-48 max-w-page px-gutter lg:mt-80">
      <ul class="grid border-y border-line-strong md:grid-cols-3">
        {proof.map((item) => (
          <li class="border-line py-24 not-first:border-t md:px-32 md:not-first:border-t-0 md:not-first:border-l md:first:pl-0 md:last:pr-0">
            <p class="flex items-baseline gap-8">
              <span class="text-h1 tabular-nums">{item.value}</span>
              <span class="text-h3 text-muted">{item.unit}</span>
            </p>
            <p class="mt-8 max-w-prose text-small text-muted">{item.label}</p>
            <a href={item.link.href} class="link link-action">
              {item.link.label}
              <Icon name="arrow-down" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
