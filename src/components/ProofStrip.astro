---
/**
 * Static proof: a few numbers, each linked to its evidence. No marquee.
 * Measured outcomes that don't exist yet are listed as TODOs in draft builds
 * and left out of production.
 */
import ExternalLink from './ExternalLink.astro';
import { resume, showTodos } from '../lib/resume';

const ready = resume.metrics.filter((m) => m.status === 'ready').slice(0, 4);
const todo = resume.metrics.filter((m) => m.status === 'todo');
---

{
  ready.length > 0 && (
    <section aria-label="Proof" class="mx-auto mt-64 max-w-page px-gutter lg:mt-96">
      <ul class="grid border-y border-line md:grid-cols-3">
        {ready.map((metric) => (
          <li class="border-line py-24 not-first:border-t md:px-32 md:not-first:border-t-0 md:not-first:border-l md:first:pl-0 md:last:pr-0">
            <p class="flex items-baseline gap-8">
              <span class="text-h1 tabular-nums">{metric.value}</span>
              {metric.unit && <span class="text-h3 text-muted">{metric.unit}</span>}
            </p>
            <p class="mt-8 text-small text-muted">{metric.label}</p>
            {metric.source && (
              <ExternalLink href={metric.source.url} action>
                {metric.source.label}
              </ExternalLink>
            )}
          </li>
        ))}
      </ul>

      {showTodos && todo.length > 0 && (
        <div class="mt-16 rounded-sm border border-dashed border-warn bg-warn-soft p-16 text-small text-warn">
          <p class="font-semibold">TODO · measured outcomes for this strip</p>
          <ul class="mt-8 grid gap-8 md:grid-cols-3 md:gap-32">
            {todo.map((metric) => (
              <li>
                <span class="font-semibold">
                  {metric.unit === '%' ? '__%' : '__'} {metric.label}.
                </span>{' '}
                {metric.how}
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )
}
