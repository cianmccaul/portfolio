---
/** The CM monogram on its accent tile. The outline lives in src/lib/monogram.ts. */
import { monogramPath } from '../lib/monogram';

interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect width="24" height="24" rx="7" fill="var(--color-accent)"></rect>
  <path d={monogramPath} fill="var(--color-accent-ink)"></path>
</svg>
