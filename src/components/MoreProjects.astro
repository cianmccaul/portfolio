---
/**
 * Smaller projects, in the same editorial list as the selected work at a
 * smaller size: a picture of the real thing, a headline, one paragraph, links.
 */
import BrowserFrame from './BrowserFrame.astro';
import SectionRail from './SectionRail.astro';
import WorkLinks from './WorkLinks.astro';
import { resume } from '../lib/resume';
import { workImage, workImageMobile } from '../lib/images';

const projects = resume.projects.filter((p) => !p.featured);
---

<SectionRail id="projects" title="More projects">
  <ul>
    {
      projects.map((item) => {
        const src = workImage(item.image);
        return (
          <li class="grid items-start gap-x-32 gap-y-16 border-line py-32 not-first:border-t first:pt-0 sm:grid-cols-9">
            {src && (
              <BrowserFrame
                src={src}
                mobile={workImageMobile(item.image)}
                alt={item.imageAlt ?? ''}
              mat={item.imageMat}
                sizes="(min-width: 1296px) 350px, (min-width: 640px) 40vw, 92vw"
                class="sm:col-span-4"
              />
            )}
            <div class:list={[src ? 'sm:col-span-5' : 'sm:col-span-9']}>
              <h3 class="text-h2">{item.name}</h3>
              <p class="mt-8 max-w-prose text-muted">{item.description}</p>
              <p class="mt-12 text-caption text-muted">{item.stack.join(' · ')}</p>
              {item.demoNote && <p class="mt-8 text-small text-muted">{item.demoNote}</p>}
              <WorkLinks project={item} class="mt-8" />
            </div>
          </li>
        );
      })
    }
  </ul>
</SectionRail>
