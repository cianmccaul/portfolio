---
import SectionRail from './SectionRail.astro';
import Todo from './Todo.astro';
import { isTodo, resume } from '../lib/resume';
import { formatDate, formatRange, graduationLabel, lowerFirst, status } from '../lib/dates';
import { now } from '../lib/site';
---

<SectionRail id="education" title="Education and awards">
  <ul>
    {
      resume.education.map((school) => (
        <li class="grid gap-x-24 gap-y-4 border-line py-24 not-first:border-t first:pt-0 lg:grid-cols-9">
          <p class="text-small text-muted tabular-nums lg:col-span-2 lg:pt-4">
            {formatRange(school.startDate, school.endDate, now, 'year')}
          </p>
          <div class="lg:col-span-7">
            <h3 class="text-h3">{school.institution}</h3>
            <p class="text-muted">
              {school.area}
              {status(school.startDate, school.endDate, now) === 'current' &&
                ` · ${lowerFirst(graduationLabel(school.endDate, now))}`}
            </p>
            {school.notes.filter((n) => !isTodo(n)).map((note) => (
              <p class="mt-12 max-w-prose">{note}</p>
            ))}
            {school.notes.filter(isTodo).map((note) => (
              <Todo block text={note} class="mt-12 max-w-prose" />
            ))}
          </div>
        </li>
      ))
    }
    {
      resume.awards.map((award) => (
        <li class="grid gap-x-24 gap-y-4 border-line py-24 not-first:border-t first:pt-0 lg:grid-cols-9">
          <p class="text-small text-muted tabular-nums lg:col-span-2 lg:pt-4">{formatDate(award.date)}</p>
          <div class="lg:col-span-7">
            <h3 class="text-h3">{award.title}</h3>
            <p class="text-muted">
              {award.awarder}
              {award.role && ` · ${award.role}`}
            </p>
            <p class="mt-12 max-w-prose">{award.summary}</p>
          </div>
        </li>
      ))
    }
  </ul>
</SectionRail>
