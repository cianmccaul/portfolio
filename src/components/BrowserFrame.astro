---
/**
 * A screenshot in a plain browser frame: a neutral bar with three dots, no
 * address. The image keeps its own proportions (never cropped) and is shown
 * exactly as supplied: no dimming, no recolouring. AVIF and WebP are
 * generated at build time.
 *
 * The frame is part of the product shot, so like the screenshot inside it, it
 * keeps its light appearance in the dark theme.
 *
 * With `mobile`, a crop of the same screenshot replaces it below 640 px.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** A crop of `src` for screens under 640 px wide. */
  mobile?: ImageMetadata;
  /** Width the frame is shown at on wide screens, for `sizes`. */
  maxWidth?: number;
  /** Overrides the `sizes` derived from maxWidth, for frames in a column. */
  sizes?: string;
  eager?: boolean;
  /** Shared-element name, so the frame travels between a card and its case study. */
  transitionName?: string;
  class?: string;
}
const { src, alt, caption, mobile, maxWidth = 1200, sizes, eager = false, transitionName, class: className } = Astro.props;
const steps = (image: ImageMetadata, list: number[]) => {
  const fit = list.filter((w) => w <= image.width);
  return fit.length ? fit : [image.width];
};
const widths = steps(src, [480, 720, 960, 1280, 1600, 2000]);
const wideSizes = sizes ?? `(min-width: ${maxWidth + 96}px) ${maxWidth}px, 92vw`;
const loading = eager ? 'eager' : 'lazy';

// Art direction: Astro's <Picture> can't switch crops by media query, so with a
// mobile crop the <picture> is written out here, from the same image service.
const MOBILE = '(max-width: 639px)';
const formats = ['avif', 'webp'] as const;
const art = mobile
  ? {
      small: await Promise.all(
        formats.map(async (format) => ({
          type: `image/${format}`,
          srcset: (await getImage({ src: mobile, widths: steps(mobile, [360, 540, 720, 800]), format })).srcSet.attribute,
        })),
      ),
      large: await Promise.all(
        formats.map(async (format) => ({
          type: `image/${format}`,
          srcset: (await getImage({ src, widths, format })).srcSet.attribute,
        })),
      ),
      fallback: await getImage({ src, width: Math.min(1280, src.width), format: 'webp' }),
    }
  : undefined;
---

<figure class:list={['not-prose', className]}>
  <div
    class="scheme-light overflow-hidden rounded-sm border border-line bg-surface shadow-e2"
    style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
  >
    <div class="flex h-24 items-center gap-4 border-b border-line bg-well px-12" aria-hidden="true">
      <span class="size-8 rounded-pill bg-n7"></span>
      <span class="size-8 rounded-pill bg-n7"></span>
      <span class="size-8 rounded-pill bg-n7"></span>
    </div>
    {
      art && mobile ? (
        <picture>
          {art.small.map((source) => (
            <source media={MOBILE} type={source.type} srcset={source.srcset} sizes="92vw" width={mobile.width} height={mobile.height} />
          ))}
          {art.large.map((source) => (
            <source type={source.type} srcset={source.srcset} sizes={wideSizes} />
          ))}
          <img
            src={art.fallback.src}
            alt={alt}
            width={src.width}
            height={src.height}
            loading={loading}
            decoding="async"
            fetchpriority={eager ? 'high' : undefined}
            class="block h-auto w-full"
          />
        </picture>
      ) : (
        <Picture
          src={src}
          alt={alt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={widths}
          sizes={wideSizes}
          loading={loading}
          fetchpriority={eager ? 'high' : undefined}
          class="block h-auto w-full"
        />
      )
    }
  </div>
  {caption && <figcaption class="mt-8 text-small text-muted">{caption}</figcaption>}
</figure>
